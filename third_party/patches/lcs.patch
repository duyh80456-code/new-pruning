diff --git a/protocol.py b/protocol.py
new file mode 100644
index 0000000..fdb40f4
--- /dev/null
+++ b/protocol.py
@@ -0,0 +1,166 @@
+#
+# Additions for running LCS under an external CIFAR-100 protocol:
+# per-epoch resume checkpoint, optional BatchNorm recalibration per width, and
+# a fixed-format per-width evaluation line. Not part of the original release.
+#
+import os
+import random
+import time
+
+import numpy as np
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+
+CKPT_NAME = "last.pt"
+_T0 = time.time()
+
+
+def _ckpt_path(regime_params):
+    return os.path.join(regime_params["ckpt_dir"], CKPT_NAME)
+
+
+def save_checkpoint(net, optimizer, next_epoch, regime_params):
+    """Model, optimizer and RNG state; the cosine schedule is a pure function
+    of the epoch (schedulers.cosine_lr), so the epoch is its whole state."""
+    path = _ckpt_path(regime_params)
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    state = {
+        "model": net.state_dict(),
+        "optimizer": optimizer.state_dict(),
+        "epoch": next_epoch,
+        "current_iteration": regime_params.get("current_iteration"),
+        "rng": {
+            "python": random.getstate(),
+            "numpy": np.random.get_state(),
+            "torch": torch.get_rng_state(),
+            "cuda": torch.cuda.get_rng_state_all()
+            if torch.cuda.is_available()
+            else None,
+        },
+    }
+    tmp = path + ".tmp"
+    torch.save(state, tmp)
+    os.replace(tmp, path)
+    print(f"Saved checkpoint {path} (next epoch {next_epoch})", flush=True)
+
+
+def load_checkpoint(net, optimizer, regime_params):
+    """Returns the epoch to start from (0 if no checkpoint)."""
+    path = _ckpt_path(regime_params)
+    if not os.path.isfile(path):
+        if regime_params.get("eval_only"):
+            raise FileNotFoundError(f"--eval_only but no checkpoint at {path}")
+        print(f"No checkpoint at {path}; starting from epoch 0", flush=True)
+        return 0
+    state = torch.load(path, map_location="cpu", weights_only=False)
+    net.load_state_dict(state["model"])
+    optimizer.load_state_dict(state["optimizer"])
+    if state.get("current_iteration") is not None:
+        regime_params["current_iteration"] = state["current_iteration"]
+    rng = state["rng"]
+    random.setstate(rng["python"])
+    np.random.set_state(rng["numpy"])
+    torch.set_rng_state(rng["torch"])
+    if rng["cuda"] is not None and torch.cuda.is_available():
+        torch.cuda.set_rng_state_all(rng["cuda"])
+    print(f"Resumed from {path} at epoch {state['epoch']}", flush=True)
+    return state["epoch"]
+
+
+_STEP = {"t": None, "n": 0}
+
+
+def step_tick(batch_idx, skip=3):
+    """Steady-state step timer: starts after the first @skip steps of an epoch
+    (cudnn autotuning, loader start-up), synchronising CUDA at each mark."""
+    if torch.cuda.is_available():
+        torch.cuda.synchronize()
+    if batch_idx == skip - 1:
+        _STEP["t"], _STEP["n"] = time.time(), 0
+    elif batch_idx >= skip and _STEP["t"] is not None:
+        _STEP["n"] += 1
+        _STEP["dt"] = time.time() - _STEP["t"]
+
+
+def steady_rate():
+    n = _STEP["n"]
+    if not n:
+        return "steady n/a"
+    return f"steady {_STEP['dt'] / n:.3f} s/step over {n} steps"
+
+
+def _tracked_bns(net):
+    return [
+        m
+        for m in net.modules()
+        if isinstance(m, nn.modules.batchnorm._NormBase)
+        and m.track_running_stats
+        and m.running_mean is not None
+    ]
+
+
+@torch.no_grad()
+def recalibrate_bn(net, loader, n_batches, device):
+    """Reset running stats, then forward n_batches training batches in train
+    mode with a cumulative average (what momentum=None does in nn.BatchNorm2d;
+    AdaptiveNorm hands momentum straight to F.batch_norm, which rejects None,
+    so the factor 1/(i+1) is set explicitly). No-op for IN/GN."""
+    bns = _tracked_bns(net)
+    if not bns or not n_batches:
+        return 0
+    saved = [m.momentum for m in bns]
+    for m in bns:
+        m.reset_running_stats()
+    net.train()
+    it = iter(loader)
+    for i in range(n_batches):
+        try:
+            data, _ = next(it)
+        except StopIteration:
+            it = iter(loader)
+            data, _ = next(it)
+        for m in bns:
+            m.momentum = 1.0 / (i + 1)
+        net(data.to(device, non_blocking=True))
+    for m, mom in zip(bns, saved):
+        m.momentum = mom
+    net.eval()
+    return len(bns)
+
+
+@torch.no_grad()
+def evaluate(net, loader, device):
+    net.eval()
+    loss_sum, c1, c5, n = 0.0, 0, 0, 0
+    for data, target in loader:
+        data = data.to(device, non_blocking=True)
+        target = target.to(device, non_blocking=True)
+        out = net(data)
+        loss_sum += F.cross_entropy(out, target, reduction="sum").item()
+        hit = out.topk(5, dim=1).indices.eq(target[:, None])
+        c1 += hit[:, 0].sum().item()
+        c5 += hit.any(dim=1).sum().item()
+        n += target.numel()
+    return loss_sum / n, 1.0 - c1 / n, 1.0 - c5 / n
+
+
+def eval_widths(net, widths, set_width, trainloader, testloader, device,
+                epochs, regime_params):
+    """One tab-separated line per width:
+    <elapsed>s  val  <width>  -1/<epochs>: loss: .., top1_error: .., top5_error: ..
+    """
+    prefix = regime_params.get("log_prefix") or ""
+    prefix = f"[{prefix}] " if prefix else ""
+    n_recal = regime_params.get("recal_batches") or 0
+    for w in widths:
+        set_width(w)
+        n_bn = recalibrate_bn(net, trainloader, n_recal, device)
+        loss, e1, e5 = evaluate(net, testloader, device)
+        if n_bn == 0 and w == widths[0]:
+            print("(no tracked BN layers: evaluated without recalibration)")
+        print(
+            f"{prefix}{time.time() - _T0:.1f}s\tval\t{w:.2f}\t-1/{epochs}: "
+            f"loss: {loss:.4f}, top1_error: {e1:.4f}, top5_error: {e5:.4f}",
+            flush=True,
+        )
