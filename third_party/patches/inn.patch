index 0000000..a13dc3c
--- /dev/null
+++ b/train_inn.py
@@ -0,0 +1,421 @@
+#
+# Phase 2 of Integral Neural Networks under an external protocol: convert
+# the trained network of train_base.py into an integral network with
+# IntegralWrapper as the released examples do (BatchNorm fused into the
+# convolutions, 2-opt TSP channel permutation, bicubic grid-sample
+# parametrization, trapezoidal quadrature), fine-tune it with the authors'
+# recipe while sampling one width per step, and evaluate it resampled to the
+# sixteen protocol widths. Not part of the original release; replaces the
+# catalyst runner of examples/classification with a plain loop, and adds
+# depthwise convolutions to the tracer (MobileNetV2; see ProtocolTracer).
+#
+import argparse
+import os
+import random
+import subprocess
+import sys
+import time
+
+import torch
+import torch.nn as nn
+
+import protocol
+from cifar_resnet import make_divisible
+
+ROOT = os.path.dirname(os.path.abspath(__file__))
+
+
+def import_torch_integral():
+    """torch_integral needs the compiled Cython TSP solver; build it in place
+    (setup.py build_ext --inplace, Linux/macOS) if it is missing."""
+    try:
+        import torch_integral.tsp_solver.solver  # noqa: F401
+    except ImportError:
+        print("TSP solver not built: running setup.py build_ext --inplace",
+              flush=True)
+        subprocess.run([sys.executable, "setup.py", "build_ext", "--inplace"],
+                       cwd=ROOT, check=True)
+    import torch_integral
+
+    return torch_integral
+
+
+def get_args():
+    p = argparse.ArgumentParser(description="INN, converted and fine-tuned")
+    p.add_argument("--arch", choices=sorted(protocol.ARCHS), default="r50")
+    p.add_argument("--dataset", choices=sorted(protocol.DATASETS),
+                   default=None, help="default: the one of --arch (r50, "
+                   "mbv2_slimlast: cifar100; r18_tiny: tinyimagenet)")
+    p.add_argument("--data_dir", required=True,
+                   help="folder that contains cifar-100-python/ "
+                        "(tinyimagenet: tiny-imagenet-200/, and the decoded "
+                        "cache tinyimagenet_cache/ is read or written there)")
+    p.add_argument("--base_ckpt", required=True,
+                   help="train_base.py checkpoint (its last.pt)")
+    p.add_argument("--ckpt_dir", required=True)
+    p.add_argument("--log_prefix", default=None,
+                   help="default: inn_<arch>")
+    # the authors' fine-tuning recipe (paper Appendix D, examples/)
+    p.add_argument("--epochs", type=int, default=50)
+    p.add_argument("--batch_size", type=int, default=128)
+    p.add_argument("--lr", type=float, default=1e-4)
+    p.add_argument("--weight_decay", type=float, default=1e-8)
+    p.add_argument("--lr_schedule", choices=["multistep", "plateau"],
+                   default="multistep")
+    p.add_argument("--milestones", default="10,20,30,40",
+                   help="multistep: epochs where lr is multiplied by gamma")
+    p.add_argument("--gamma", type=float, default=0.33)
+    p.add_argument("--patience", type=int, default=10,
+                   help="plateau: epochs without a lower training loss")
+    p.add_argument("--grad_clip", type=float, default=0.0)
+    # conversion
+    p.add_argument("--tsp_iters", type=int, default=100,
+                   help="2-opt random restarts per group (NOptPermutation)")
+    # width sampling and evaluation
+    p.add_argument("--min_width", type=float, default=0.25)
+    p.add_argument("--max_width", type=float, default=1.0)
+    p.add_argument("--recal_batches", type=int, default=20,
+                   help="used only if BatchNorm layers survive conversion")
+    p.add_argument("--eval_converted", action="store_true",
+                   help="also test the 16 widths right after conversion "
+                        "(no fine-tuning), tagged <log_prefix>_conv")
+    p.add_argument("--seed", type=int, default=1995)
+    p.add_argument("--stop_at_epoch", type=int, default=None,
+                   help="exit cleanly once this many epochs are done")
+    p.add_argument("--eval_only", action="store_true")
+    p.add_argument("--max_iters_per_epoch", type=int, default=None,
+                   help="smoke tests only")
+    args = p.parse_args()
+    if args.log_prefix is None:
+        args.log_prefix = "inn_" + args.arch
+    return args
+
+
+def layer_shapes(model):
+    """{module name: (out, in)} of every Conv2d / Linear, read from the
+    weight (resampling changes the weight, not out_channels/in_channels)."""
+    shapes = {}
+    for name, m in model.named_modules():
+        if isinstance(m, (nn.Conv2d, nn.Linear)):
+            shapes[name] = tuple(m.weight.shape[:2])
+    return shapes
+
+
+def protocol_shapes(args, num_classes, w):
+    """layer_shapes of the protocol's network at width w: the same plain
+    model built at that width (on the meta device, no memory), i.e.
+    make_divisible(C * w) channels, t * make_divisible(C_in * w) on
+    MobileNetV2's expanded ones, RGB input and classes unchanged."""
+    with torch.device("meta"):
+        net = protocol.build_model(args.arch, num_classes, width=w)
+    return layer_shapes(net)
+
+
+def channels(size, w, ratio):
+    """The protocol's channel count at width w of a dimension of `size`
+    channels, with US-Net's ratio rounding make_divisible(size * w / ratio)
+    * ratio (ratio = the expansion t on MobileNetV2's expanded channels,
+    else 1, i.e. make_divisible(size * w))."""
+    return make_divisible(size * w / ratio) * ratio
+
+
+def group_ratio(model, group):
+    """The ratio of an integral group: what its layers declare as
+    channel_ratio = (out, in) (cifar_mobilenetv2; 1 if absent), which must
+    be the same for every tensor of the group."""
+    ratios = set()
+    for p in group.params:
+        layer, attr = p["name"].rsplit(".", 1)
+        declared = getattr(model.get_submodule(layer), "channel_ratio", (1, 1))
+        ratios.add(declared[0] if attr == "bias" else declared[p["dim"]])
+    if len(ratios) != 1:
+        raise RuntimeError("group of {} channels mixes ratios {}".format(
+            group.size, sorted(ratios)))
+    return ratios.pop()
+
+
+def make_tracer(ti):
+    """IntegralTracer that also handles depthwise convolutions.
+
+    The released conv hook ties the weight's dim 1 to the input channels
+    and its dim 0 to the output channels. For a depthwise conv (groups =
+    in = out channels) dim 1 has size 1, so the released tracer puts that
+    size-1 dimension into the input's group and makes the output channels a
+    group of their own: two independent grids for what is one channel axis,
+    and the resampled network breaks (checked: weight [16, 16, 3, 3] at
+    groups 16). Here a depthwise conv maps channel c to channel c, so its
+    input channels, its weight's dim 0 (and bias) and its output channels
+    are merged into ONE group; the weight's dim 1 is left discrete (it is
+    not in continuous_dims, see convert), so its parametrization is 1-D
+    along the channels and has no quadrature (nothing is summed over
+    channels). Every other module goes through the released hooks."""
+    from torch_integral.graph.group import RelatedGroup
+    from torch_integral.graph.operations import merge_groups
+
+    def depthwise_hook(module, inputs, output):
+        weight, bias = module.weight, module.bias
+        if bias is not None:
+            merge_groups(bias, 0, weight, 0)
+        merge_groups(weight, 0, inputs[0], 1)
+        merge_groups(output, 1, weight, 0)
+        RelatedGroup.append_to_groups(output, "conv_linear")
+
+    class ProtocolTracer(ti.IntegralTracer):
+        def call_module(self, target, args, kwargs):
+            submod = self.fetch_attr(target)
+            if is_grouped(submod):
+                if not (submod.groups == submod.in_channels
+                        == submod.out_channels):
+                    raise NotImplementedError(
+                        "{}: only depthwise grouped convs".format(target))
+                submod.register_forward_hook(depthwise_hook)
+                return submod(*args, **kwargs)
+            return super().call_module(target, args, kwargs)
+
+    return ProtocolTracer
+
+
+def is_grouped(m):
+    return isinstance(m, nn.Conv2d) and m.groups > 1
+
+
+def convert(ti, model, args, image_size, init_from_discrete):
+    """Their examples' conversion: every Conv2d/Linear weight continuous along
+    out and in channels (standard_continuous_dims), except the RGB input of
+    the stem and the class dimension of the classifier (discrete_dims, as
+    imagenet.py keeps fc discrete), and a depthwise weight along its
+    channels only (its dim 1 has size 1). fuse_bn=True (their default)."""
+    continuous_dims = ti.standard_continuous_dims(model)
+    for name, m in model.named_modules():
+        if is_grouped(m):
+            continuous_dims[name + ".weight"] = [0]
+    discrete_dims = {"conv1.weight": [1], "fc.weight": [0], "fc.bias": [0]}
+    wrapper = ti.IntegralWrapper(
+        init_from_discrete=init_from_discrete,
+        fuse_bn=True,
+        permutation_config={"iters": args.tsp_iters},
+        verbose=init_from_discrete,
+    )
+    inn = wrapper(model, [1, 3, image_size, image_size], continuous_dims,
+                  discrete_dims, integral_tracer_class=make_tracer(ti))
+    for g in inn.groups:
+        assert g.subgroups is None, "concatenated groups are not expected"
+        g.protocol_ratio = group_ratio(inn.model, g)
+    return inn
+
+
+def describe_groups(inn):
+    """Which layer widths each integral group is."""
+    print("{} integral groups (full size -> size at w = 0.25 / 0.50 / 1.00):"
+          .format(len(inn.groups)))
+    for i, g in enumerate(inn.groups):
+        names = sorted({"{}[{}]".format(p["name"], p["dim"]) for p in g.params
+                        if not p["name"].endswith("bias")})
+        kind = "residual stream" if "operator" in g.operations else "inner"
+        if g.protocol_ratio != 1:
+            kind += ", t={}".format(g.protocol_ratio)
+        print("  group {:2d}: {:4d} -> {:4d} / {:4d} / {:4d}  {:15s} {}".format(
+            i, g.size, channels(g.size, 0.25, g.protocol_ratio),
+            channels(g.size, 0.5, g.protocol_ratio), g.size, kind,
+            ", ".join(names)), flush=True)
+
+
+def check_group_sizes(inn, args, num_classes):
+    """Before any training: at each of the 16 widths, the size every group
+    is given (channels(size, w, ratio)) is the channel count the protocol's
+    network has there in every tensor of the group."""
+    for w in protocol.WIDTHS:
+        shapes = protocol_shapes(args, num_classes, w)
+        for g in inn.groups:
+            n = channels(g.size, w, g.protocol_ratio)
+            for p in g.params:
+                layer, attr = p["name"].rsplit(".", 1)
+                want = shapes[layer][0 if attr == "bias" else p["dim"]]
+                if n != want:
+                    raise RuntimeError(
+                        "width {}: group of {} gets {} points, but {}[{}] has "
+                        "{} channels".format(w, g.size, n, p["name"], p["dim"],
+                                             want))
+    print("Group sizes = the protocol's channel counts at all {} widths"
+          .format(len(protocol.WIDTHS)), flush=True)
+
+
+def set_train_width(ti, inn, w):
+    """One width for the whole network: every group draws exactly its
+    channel count at w (channels(), the protocol's rounding) in this step
+    (their RandomLinspace with a one-point UniformDistribution)."""
+    for g in inn.groups:
+        n = channels(g.size, w, g.protocol_ratio)
+        g.reset_distribution(ti.UniformDistribution(n, n))
+
+
+def set_eval_width(inn, w):
+    for g in inn.groups:
+        g.resize(channels(g.size, w, g.protocol_ratio))
+
+
+def discrete_at(inn, w, args, num_classes):
+    """Resample the INN at width w and return the ordinary network; checks
+    that its channel counts are the protocol's at that width."""
+    inn.eval()
+    set_eval_width(inn, w)
+    net = inn.get_unparametrized_model()
+    net.eval()
+    shapes = layer_shapes(net)
+    expected = protocol_shapes(args, num_classes, w)
+    bad = [(n, shapes.get(n), expected.get(n))
+           for n in sorted(set(shapes) | set(expected))
+           if shapes.get(n) != expected.get(n)]
+    if bad:
+        raise RuntimeError("width {}: channel counts differ from the "
+                           "protocol's network: {}".format(w, bad[:5]))
+    print("width {:.2f}: {:,} parameters, channel counts = the protocol's "
+          "in all {} conv/linear layers".format(
+              w, sum(p.numel() for p in net.parameters()), len(shapes)),
+          flush=True)
+    return net
+
+
+def lr_for_epoch(args, epoch):
+    milestones = [int(m) for m in args.milestones.split(",") if m]
+    return args.lr * args.gamma ** sum(epoch >= m for m in milestones)
+
+
+def train_epoch(ti, inn, loader, optimizer, criterion, args, epoch, device):
+    inn.train()
+    if torch.cuda.is_available():
+        torch.cuda.reset_peak_memory_stats()
+    start = time.time()
+    loss_sum, seen, widths, steps = 0.0, 0, 0.0, 0
+    for batch_idx, (data, target) in enumerate(loader):
+        if args.max_iters_per_epoch and batch_idx >= args.max_iters_per_epoch:
+            break
+        data = data.to(device, non_blocking=True)
+        target = target.to(device, non_blocking=True)
+        w = random.uniform(args.min_width, args.max_width)
+        set_train_width(ti, inn, w)
+        out = inn(data)
+        loss = criterion(out, target)
+        optimizer.zero_grad(set_to_none=True)
+        loss.backward()
+        if args.grad_clip:
+            nn.utils.clip_grad_norm_(inn.parameters(), args.grad_clip)
+        optimizer.step()
+        loss_sum += loss.item() * target.numel()
+        seen += target.numel()
+        widths += w
+        steps += 1
+        protocol.step_tick(batch_idx)
+    print("Epoch {} train time {:.1f}s, {} steps, loss {:.4f}, mean width "
+          "{:.3f}, lr {:.3g}, {}, {}".format(
+              epoch, time.time() - start, steps, loss_sum / max(seen, 1),
+              widths / max(steps, 1), optimizer.param_groups[0]["lr"],
+              protocol.steady_rate(), protocol.peak_memory()), flush=True)
+    return loss_sum / max(seen, 1)
+
+
+def main():
+    args = get_args()
+    ti = import_torch_integral()
+    protocol.seed_everything(args.seed)
+    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
+    # a new width almost every step: cuDNN autotuning would retune each time
+    torch.backends.cudnn.benchmark = False
+
+    data = protocol.setting(args)
+    base_state = torch.load(args.base_ckpt, map_location="cpu",
+                            weights_only=False)
+    # (checkpoints written before --arch existed are ResNet-50 ones)
+    if base_state.get("arch", "r50") != args.arch:
+        raise ValueError("{} is a {} base, not {}".format(
+            args.base_ckpt, base_state.get("arch"), args.arch))
+    model = protocol.build_model(args.arch, data["num_classes"])
+    model.load_state_dict(base_state["model"])
+    model.to(device)
+    print("Base network {} on {} from {} (trained {} of {} epochs)".format(
+        protocol.ARCHS[args.arch]["name"], args.dataset, args.base_ckpt,
+        base_state.get("epoch"), base_state.get("epochs")), flush=True)
+
+    state = protocol.read_checkpoint(args.ckpt_dir)
+    if state is None and args.eval_only:
+        raise FileNotFoundError(
+            "--eval_only but no checkpoint in {}".format(args.ckpt_dir))
+
+    start = time.time()
+    # With a checkpoint the permutation is not searched again: the structure
+    # is rebuilt and the trained (permuted) parametrization loaded into it,
+    # as imagenet.py does with --checkpoint.
+    inn = convert(ti, model, args, data["image_size"],
+                  init_from_discrete=state is None)
+    print("Conversion took {:.1f}s{}".format(
+        time.time() - start, "" if state is None else " (no permutation: "
+        "weights come from the checkpoint)"), flush=True)
+    describe_groups(inn)
+    print("BatchNorm layers left after conversion: {}".format(
+        len(protocol.tracked_bns(inn))), flush=True)
+    check_group_sizes(inn, args, data["num_classes"])
+
+    optimizer = torch.optim.Adam(inn.parameters(), lr=args.lr,
+                                 weight_decay=args.weight_decay)
+    plateau = torch.optim.lr_scheduler.ReduceLROnPlateau(
+        optimizer, mode="min", factor=args.gamma, patience=args.patience) \
+        if args.lr_schedule == "plateau" else None
+    criterion = nn.CrossEntropyLoss()
+    train_loader, recal_loader, test_loader = data["loaders"](
+        args.data_dir, args.batch_size, protocol.workers())
+
+    def save(next_epoch):
+        protocol.save_checkpoint(
+            args.ckpt_dir, next_epoch, model=inn.state_dict(),
+            optimizer=optimizer.state_dict(),
+            plateau=plateau.state_dict() if plateau is not None else None,
+            kind="inn", epochs=args.epochs, arch=args.arch,
+            dataset=args.dataset)
+
+    if state is None:
+        start_epoch = 0
+        # the converted network, so that a resume never repeats the search
+        save(0)
+    else:
+        inn.load_state_dict(state["model"])
+        optimizer.load_state_dict(state["optimizer"])
+        if plateau is not None and state.get("plateau") is not None:
+            plateau.load_state_dict(state["plateau"])
+        protocol.restore_rng(state)
+        start_epoch = state["epoch"]
+        print("Resumed from {} at epoch {}".format(args.ckpt_dir, start_epoch),
+              flush=True)
+
+    def test(tag, epochs):
+        protocol.eval_widths(
+            protocol.WIDTHS,
+            lambda w: discrete_at(inn, w, args, data["num_classes"]),
+            recal_loader, test_loader, device, epochs, args.recal_batches,
+            tag)
+
+    if args.eval_converted and start_epoch == 0:
+        test(args.log_prefix + "_conv", 0)
+
+    if not args.eval_only:
+        for epoch in range(start_epoch, args.epochs):
+            if plateau is None:
+                for group in optimizer.param_groups:
+                    group["lr"] = lr_for_epoch(args, epoch)
+            loss = train_epoch(ti, inn, train_loader, optimizer, criterion,
+                               args, epoch, device)
+            if plateau is not None:
+                plateau.step(loss)
+            save(epoch + 1)
+            if (args.stop_at_epoch is not None
+                    and epoch + 1 >= args.stop_at_epoch
+                    and epoch + 1 < args.epochs):
+                print("Stopping after epoch {} (--stop_at_epoch {}); rerun "
+                      "to resume.".format(epoch, args.stop_at_epoch),
+                      flush=True)
+                return
+
+    test(args.log_prefix, args.epochs)
+
+
+if __name__ == "__main__":
+    main()
