index 0000000..db9f251
--- /dev/null
+++ b/protocol.py
@@ -0,0 +1,212 @@
+#
+# Additions for running Integral Neural Networks under an external CIFAR-100
+# protocol: the CIFAR-100 loaders, a per-epoch resume checkpoint, a steady
+# step timer, BatchNorm recalibration, and a fixed-format per-width
+# evaluation line. Not part of the original release.
+#
+import os
+import random
+import statistics
+import time
+
+import numpy as np
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+
+CKPT_NAME = "last.pt"
+_T0 = time.time()
+
+# the sixteen evaluated widths
+WIDTHS = [round(0.25 + 0.05 * i, 2) for i in range(16)]
+
+CIFAR100_MEAN = (0.5071, 0.4865, 0.4409)
+CIFAR100_STD = (0.2673, 0.2564, 0.2762)
+
+
+def workers():
+    return int(os.environ.get("INN_WORKERS", "2"))
+
+
+def seed_everything(seed):
+    random.seed(seed)
+    np.random.seed(seed % 2**32)
+    torch.manual_seed(seed)
+    torch.cuda.manual_seed_all(seed)
+
+
+def cifar100_loaders(data_dir, batch_size, n_workers):
+    """train (RandomCrop 32 pad 4 + HFlip, shuffled, last partial batch
+    kept), recalibration (same images and transform, its own shuffle), test
+    (10k, no augmentation). data_dir contains cifar-100-python/."""
+    import torchvision
+    import torchvision.transforms as transforms
+
+    train_tf = transforms.Compose([
+        transforms.RandomCrop(32, padding=4),
+        transforms.RandomHorizontalFlip(),
+        transforms.ToTensor(),
+        transforms.Normalize(CIFAR100_MEAN, CIFAR100_STD),
+    ])
+    test_tf = transforms.Compose([
+        transforms.ToTensor(),
+        transforms.Normalize(CIFAR100_MEAN, CIFAR100_STD),
+    ])
+    trainset = torchvision.datasets.CIFAR100(
+        root=data_dir, train=True, download=True, transform=train_tf)
+    testset = torchvision.datasets.CIFAR100(
+        root=data_dir, train=False, download=True, transform=test_tf)
+    common = dict(num_workers=n_workers, pin_memory=True,
+                  persistent_workers=n_workers > 0)
+    train = torch.utils.data.DataLoader(
+        trainset, batch_size=batch_size, shuffle=True, **common)
+    # recalibration batches are always 256 images, as in the protocol
+    recal = torch.utils.data.DataLoader(
+        trainset, batch_size=256, shuffle=True, drop_last=True, **common)
+    test = torch.utils.data.DataLoader(
+        testset, batch_size=256, shuffle=False, **common)
+    return train, recal, test
+
+
+def save_checkpoint(ckpt_dir, next_epoch, **states):
+    """Written atomically (.tmp + os.replace): the given state dicts, the
+    next epoch, and the Python/NumPy/torch/CUDA RNG states."""
+    path = os.path.join(ckpt_dir, CKPT_NAME)
+    os.makedirs(ckpt_dir, exist_ok=True)
+    state = dict(states)
+    state["epoch"] = next_epoch
+    state["rng"] = {
+        "python": random.getstate(),
+        "numpy": np.random.get_state(),
+        "torch": torch.get_rng_state(),
+        "cuda": torch.cuda.get_rng_state_all()
+        if torch.cuda.is_available() else None,
+    }
+    tmp = path + ".tmp"
+    torch.save(state, tmp)
+    os.replace(tmp, path)
+    print("Saved checkpoint {} (next epoch {})".format(path, next_epoch),
+          flush=True)
+
+
+def read_checkpoint(ckpt_dir):
+    """The checkpoint dict, or None if there is none."""
+    path = os.path.join(ckpt_dir, CKPT_NAME)
+    if not os.path.isfile(path):
+        return None
+    return torch.load(path, map_location="cpu", weights_only=False)
+
+
+def restore_rng(state):
+    rng = state["rng"]
+    random.setstate(rng["python"])
+    np.random.set_state(rng["numpy"])
+    torch.set_rng_state(rng["torch"])
+    if rng["cuda"] is not None and torch.cuda.is_available():
+        torch.cuda.set_rng_state_all(rng["cuda"])
+
+
+_STEP = {"t": None, "dts": []}
+
+
+def step_tick(batch_idx, skip=3):
+    """Steady-state step timer: starts after the first @skip steps of an
+    epoch (loader start-up), synchronising CUDA at each mark."""
+    if torch.cuda.is_available():
+        torch.cuda.synchronize()
+    now = time.time()
+    if batch_idx == skip - 1:
+        _STEP["dts"] = []
+    elif batch_idx >= skip and _STEP["t"] is not None:
+        _STEP["dts"].append(now - _STEP["t"])
+    _STEP["t"] = now
+
+
+def steady_rate():
+    dts = _STEP["dts"]
+    if not dts:
+        return "steady n/a"
+    return "steady {:.3f} s/step mean, {:.3f} median over {} steps".format(
+        sum(dts) / len(dts), statistics.median(dts), len(dts))
+
+
+def peak_memory():
+    if not torch.cuda.is_available():
+        return "peak mem n/a"
+    return "peak mem {:.2f} GiB".format(
+        torch.cuda.max_memory_allocated() / 2**30)
+
+
+def tracked_bns(net):
+    return [m for m in net.modules()
+            if isinstance(m, nn.modules.batchnorm._NormBase)
+            and m.track_running_stats and m.running_mean is not None]
+
+
+@torch.no_grad()
+def recalibrate_bn(net, loader, n_batches, device):
+    """Reset running stats, then forward n_batches training batches in train
+    mode with a cumulative average (momentum 1/(i+1), what momentum=None
+    does in nn.BatchNorm2d). Returns the number of BN layers (0: no-op)."""
+    bns = tracked_bns(net)
+    if not bns or not n_batches:
+        return 0
+    saved = [m.momentum for m in bns]
+    for m in bns:
+        m.reset_running_stats()
+    net.train()
+    it = iter(loader)
+    for i in range(n_batches):
+        try:
+            data, _ = next(it)
+        except StopIteration:
+            it = iter(loader)
+            data, _ = next(it)
+        for m in bns:
+            m.momentum = 1.0 / (i + 1)
+        net(data.to(device, non_blocking=True))
+    for m, mom in zip(bns, saved):
+        m.momentum = mom
+    net.eval()
+    return len(bns)
+
+
+@torch.no_grad()
+def evaluate(net, loader, device):
+    net.eval()
+    loss_sum, c1, c5, n = 0.0, 0, 0, 0
+    for data, target in loader:
+        data = data.to(device, non_blocking=True)
+        target = target.to(device, non_blocking=True)
+        out = net(data)
+        loss_sum += F.cross_entropy(out, target, reduction="sum").item()
+        hit = out.topk(5, dim=1).indices.eq(target[:, None])
+        c1 += hit[:, 0].sum().item()
+        c5 += hit.any(dim=1).sum().item()
+        n += target.numel()
+    return loss_sum / n, 1.0 - c1 / n, 1.0 - c5 / n
+
+
+def eval_widths(widths, get_net, recal_loader, test_loader, device, epochs,
+                n_recal, log_prefix=""):
+    """One tab-separated line per width:
+    <elapsed>s  val  <width>  -1/<epochs>: loss: .., top1_error: .., top5_error: ..
+    get_net(w) returns the network to test at width w."""
+    prefix = "[{}] ".format(log_prefix) if log_prefix else ""
+    for w in widths:
+        net = get_net(w)
+        n_bn = recalibrate_bn(net, recal_loader, n_recal, device)
+        loss, e1, e5 = evaluate(net, test_loader, device)
+        if w == widths[0]:
+            if n_bn:
+                print("(BN recalibrated per width: {} layers, {} batches of "
+                      "256, cumulative)".format(n_bn, n_recal))
+            elif tracked_bns(net):
+                print("(no recalibration: evaluated with the trained "
+                      "running stats)")
+            else:
+                print("(no BatchNorm layers: evaluated without "
+                      "recalibration)")
+        print("{}{:.1f}s\tval\t{:.2f}\t-1/{}: loss: {:.4f}, top1_error: {:.4f}, "
+              "top5_error: {:.4f}".format(prefix, time.time() - _T0, w, epochs,
+                                          loss, e1, e5), flush=True)
