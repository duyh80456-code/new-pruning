index 0000000..aac1d08
--- /dev/null
+++ b/cifar_mobilenetv2.py
@@ -0,0 +1,144 @@
+#
+# A plain CIFAR MobileNetV2 with the last 1x1 slimmed (ordinary torch.nn
+# modules) for running Integral Neural Networks under an external protocol.
+# Not part of the original release.
+#
+# Same network as the protocol's slimmable MobileNetV2 with slim_last, at
+# width w: 3x3 stride-1 stem to 32, inverted residuals (t, c, n, s) =
+# (1, 16, 1, 1), (6, 24, 2, 1), (6, 32, 3, 2), (6, 64, 4, 2), (6, 96, 3, 1),
+# (6, 160, 3, 2), (6, 320, 1, 1) (ImageNet's second stride of 2 becomes 1, so
+# the last stage sees 4 pixels), each [1x1 expansion + BN + ReLU6, absent
+# where t = 1] -> 3x3 depthwise (stride) + BN + ReLU6 -> 1x1 projection + BN,
+# the identity added where the stride is 1 and the full-width input and
+# output agree (no projection shortcut); then a 1x1 conv to 1280 + BN +
+# ReLU6, global average pool, linear classifier with bias. slim_last: that
+# last 1x1 slims with the width as well (1280 x w channels, and with it the
+# classifier input).
+#
+# Channel counts at width w (the protocol's rounding): stem, block outputs
+# and the last 1x1 make_divisible(C * w); the expansion 1x1 and the depthwise
+# 3x3 t * make_divisible(C_in * w), t times the block's input channels at
+# that width (US-Net's ratio rounding, make_divisible(C_in * t * w / t) * t).
+# Every conv records that ratio as channel_ratio = (out, in), read by
+# train_inn.py to size the integral groups.
+#
+# The depthwise conv is an nn.Conv2d with groups = channels. A forward
+# pre-hook sets groups to the channel count of its input at every call (as
+# the protocol's slimmable conv sets groups = in_channels at each width), so
+# the network stays depthwise when the INN resamples it to fewer channels.
+#
+import math
+
+import torch
+import torch.nn as nn
+
+from cifar_resnet import make_divisible
+
+
+def _depthwise_groups(conv, args):
+    """one filter per input channel at any channel count"""
+    conv.groups = args[0].shape[1]
+
+
+class InvertedResidual(nn.Module):
+    def __init__(self, inp, mid, outp, stride, t, residual):
+        super().__init__()
+        self.residual = residual
+        if t != 1:
+            self.conv1 = nn.Conv2d(inp, mid, 1, 1, 0, bias=False)
+            self.conv1.channel_ratio = (t, 1)
+            self.bn1 = nn.BatchNorm2d(mid)
+        else:
+            assert mid == inp
+            self.conv1 = None
+        self.conv2 = nn.Conv2d(mid, mid, 3, stride, 1, groups=mid, bias=False)
+        self.conv2.channel_ratio = (t, t)
+        self.conv2.register_forward_pre_hook(_depthwise_groups)
+        self.bn2 = nn.BatchNorm2d(mid)
+        self.conv3 = nn.Conv2d(mid, outp, 1, 1, 0, bias=False)
+        self.conv3.channel_ratio = (1, t)
+        self.bn3 = nn.BatchNorm2d(outp)
+        self.relu = nn.ReLU6(inplace=True)
+
+    def forward(self, x):
+        out = x
+        if self.conv1 is not None:
+            out = self.relu(self.bn1(self.conv1(out)))
+        out = self.relu(self.bn2(self.conv2(out)))
+        out = self.bn3(self.conv3(out))
+        if self.residual:
+            out = out + x
+
+        return out
+
+
+class CifarMobileNetV2(nn.Module):
+    # t, c, n, s; ImageNet's second stride of 2 becomes 1
+    block_setting = [
+        [1, 16, 1, 1],
+        [6, 24, 2, 1],
+        [6, 32, 3, 2],
+        [6, 64, 4, 2],
+        [6, 96, 3, 1],
+        [6, 160, 3, 2],
+        [6, 320, 1, 1],
+    ]
+
+    def __init__(self, num_classes=100, width=1.0, last_channels=1280):
+        super().__init__()
+
+        def md(c):
+            return make_divisible(c * width)
+
+        full = 32
+        self.conv1 = nn.Conv2d(3, md(full), 3, 1, 1, bias=False)
+        self.bn1 = nn.BatchNorm2d(md(full))
+        self.relu = nn.ReLU6(inplace=True)
+
+        blocks = []
+        for t, c, n, s in self.block_setting:
+            for i in range(n):
+                stride = s if i == 0 else 1
+                blocks.append(InvertedResidual(
+                    md(full), t * md(full), md(c), stride, t,
+                    residual=stride == 1 and full == c))
+                full = c
+        self.layers = nn.Sequential(*blocks)
+
+        # slim_last: the last 1x1 slims with the width
+        self.conv_last = nn.Conv2d(md(full), md(last_channels), 1, 1, 0,
+                                   bias=False)
+        self.bn_last = nn.BatchNorm2d(md(last_channels))
+        self.avgpool = nn.AdaptiveAvgPool2d(1)
+        self.fc = nn.Linear(md(last_channels), num_classes)
+        self.reset_parameters()
+
+    def forward(self, x):
+        x = self.relu(self.bn1(self.conv1(x)))
+        x = self.layers(x)
+        x = self.relu(self.bn_last(self.conv_last(x)))
+        x = self.avgpool(x)
+        x = torch.flatten(x, 1)
+
+        return self.fc(x)
+
+    def reset_parameters(self):
+        """The protocol's initialisation: convs N(0, 2 / (k*k*C_out))
+        (depthwise included), BN gamma 1 / beta 0, classifier N(0, 0.01) with
+        zero bias."""
+        for m in self.modules():
+            if isinstance(m, nn.Conv2d):
+                n = m.kernel_size[0] * m.kernel_size[1] * m.out_channels
+                m.weight.data.normal_(0, math.sqrt(2.0 / n))
+                if m.bias is not None:
+                    m.bias.data.zero_()
+            elif isinstance(m, nn.BatchNorm2d):
+                m.weight.data.fill_(1)
+                m.bias.data.zero_()
+            elif isinstance(m, nn.Linear):
+                m.weight.data.normal_(0, 0.01)
+                m.bias.data.zero_()
+
+
+def mobilenetv2_cifar_slimlast(num_classes=100, width=1.0):
+    return CifarMobileNetV2(num_classes, width)
