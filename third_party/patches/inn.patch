new file mode 100644
index 0000000..71b573d
--- /dev/null
+++ b/train_base.py
@@ -0,0 +1,169 @@
+#
+# Phase 1 of Integral Neural Networks under an external protocol: train the
+# ordinary (discrete) network that train_inn.py converts (--arch: CIFAR
+# ResNet-50, ResNet-18 for 64x64 Tiny ImageNet, CIFAR MobileNetV2 with the
+# last 1x1 slimmed). Not part of the original release (the paper starts from
+# pre-trained pytorchcv / torchvision networks; here the network is trained
+# with the protocol's recipe). The result is also the protocol's individual
+# network at width 1.0, printed as one protocol line.
+#
+import argparse
+import math
+import time
+
+import torch
+import torch.nn as nn
+
+import protocol
+
+
+def get_args():
+    p = argparse.ArgumentParser(description="INN base network")
+    p.add_argument("--arch", choices=sorted(protocol.ARCHS), default="r50")
+    p.add_argument("--dataset", choices=sorted(protocol.DATASETS),
+                   default=None, help="default: the one of --arch (r50, "
+                   "mbv2_slimlast: cifar100; r18_tiny: tinyimagenet)")
+    p.add_argument("--data_dir", required=True,
+                   help="folder that contains cifar-100-python/ "
+                        "(tinyimagenet: tiny-imagenet-200/, and the decoded "
+                        "cache tinyimagenet_cache/ is read or written there)")
+    p.add_argument("--ckpt_dir", required=True)
+    p.add_argument("--log_prefix", default="inn_base")
+    p.add_argument("--epochs", type=int, default=100)
+    p.add_argument("--batch_size", type=int, default=256)
+    p.add_argument("--lr", type=float, default=0.2)
+    p.add_argument("--momentum", type=float, default=0.9)
+    p.add_argument("--weight_decay", type=float, default=5e-4)
+    p.add_argument("--warmup_epochs", type=int, default=5)
+    p.add_argument("--grad_clip", type=float, default=5.0)
+    p.add_argument("--seed", type=int, default=1995)
+    p.add_argument("--recal_batches", type=int, default=20,
+                   help="BN recalibration batches before the test (0: the "
+                        "trained running stats)")
+    p.add_argument("--stop_at_epoch", type=int, default=None,
+                   help="exit cleanly once this many epochs are done")
+    p.add_argument("--eval_only", action="store_true")
+    p.add_argument("--max_iters_per_epoch", type=int, default=None,
+                   help="smoke tests only")
+    return p.parse_args()
+
+
+def make_optimizer(model, args):
+    """Nesterov SGD; weight decay on conv (non-depthwise) and linear weights
+    only, none on BN parameters and biases (the protocol's rule)."""
+    groups = []
+    for param in model.parameters():
+        shape = list(param.size())
+        decay = (len(shape) == 4 and shape[1] != 1) or len(shape) == 2
+        groups.append({"params": [param],
+                       "weight_decay": args.weight_decay if decay else 0.0})
+    return torch.optim.SGD(groups, lr=args.lr, momentum=args.momentum,
+                           nesterov=True)
+
+
+def set_lr(optimizer, args, epoch, batch_idx, data_size):
+    """Per step: linear warm-up from 0 to lr over warmup_epochs, then cosine
+    to 0 over the remaining epochs (the protocol's schedule; steps per epoch
+    counted as data_size / batch_size, data_size = the training images)."""
+    per_epoch = data_size / args.batch_size
+    current = epoch * per_epoch + batch_idx + 1
+    if epoch < args.warmup_epochs:
+        lr = current * args.lr / args.warmup_epochs / per_epoch
+    else:
+        rest = args.epochs - args.warmup_epochs
+        lr = args.lr * (1.0 + math.cos(
+            math.pi * (current - args.warmup_epochs * per_epoch)
+            / rest / per_epoch)) / 2.0
+    for group in optimizer.param_groups:
+        group["lr"] = lr
+    return lr
+
+
+def train_epoch(model, loader, optimizer, criterion, args, epoch, device):
+    model.train()
+    if torch.cuda.is_available():
+        torch.cuda.reset_peak_memory_stats()
+    start = time.time()
+    loss_sum, correct, seen, steps, lr = 0.0, 0, 0, 0, 0.0
+    for batch_idx, (data, target) in enumerate(loader):
+        if args.max_iters_per_epoch and batch_idx >= args.max_iters_per_epoch:
+            break
+        data = data.to(device, non_blocking=True)
+        target = target.to(device, non_blocking=True)
+        lr = set_lr(optimizer, args, epoch, batch_idx,
+                    len(loader.dataset))
+        out = model(data)
+        loss = criterion(out, target)
+        optimizer.zero_grad(set_to_none=True)
+        loss.backward()
+        if args.grad_clip:
+            nn.utils.clip_grad_norm_(model.parameters(), args.grad_clip)
+        optimizer.step()
+        loss_sum += loss.item() * target.numel()
+        correct += out.argmax(1).eq(target).sum().item()
+        seen += target.numel()
+        steps += 1
+        protocol.step_tick(batch_idx)
+    print("Epoch {} train time {:.1f}s, {} steps, loss {:.4f}, top1_error "
+          "{:.4f}, lr now {:.5f}, {}, {}".format(
+              epoch, time.time() - start, steps,
+              loss_sum / max(seen, 1), 1.0 - correct / max(seen, 1), lr,
+              protocol.steady_rate(), protocol.peak_memory()), flush=True)
+
+
+def main():
+    args = get_args()
+    protocol.seed_everything(args.seed)
+    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
+    torch.backends.cudnn.benchmark = True  # fixed shapes in this phase
+
+    data = protocol.setting(args)
+    model = protocol.build_model(args.arch, data["num_classes"]).to(device)
+    print("{} on {}: {:,} parameters".format(
+        protocol.ARCHS[args.arch]["name"], args.dataset,
+        sum(p.numel() for p in model.parameters())), flush=True)
+    optimizer = make_optimizer(model, args)
+    criterion = nn.CrossEntropyLoss()
+    train_loader, recal_loader, test_loader = data["loaders"](
+        args.data_dir, args.batch_size, protocol.workers())
+
+    start_epoch = 0
+    state = protocol.read_checkpoint(args.ckpt_dir)
+    if state is not None:
+        model.load_state_dict(state["model"])
+        optimizer.load_state_dict(state["optimizer"])
+        protocol.restore_rng(state)
+        start_epoch = state["epoch"]
+        print("Resumed from {} at epoch {}".format(args.ckpt_dir, start_epoch),
+              flush=True)
+    elif args.eval_only:
+        raise FileNotFoundError(
+            "--eval_only but no checkpoint in {}".format(args.ckpt_dir))
+    else:
+        print("No checkpoint in {}; starting from epoch 0".format(
+            args.ckpt_dir), flush=True)
+
+    if not args.eval_only:
+        for epoch in range(start_epoch, args.epochs):
+            train_epoch(model, train_loader, optimizer, criterion, args,
+                        epoch, device)
+            protocol.save_checkpoint(
+                args.ckpt_dir, epoch + 1, model=model.state_dict(),
+                optimizer=optimizer.state_dict(), kind="base",
+                epochs=args.epochs, arch=args.arch, dataset=args.dataset)
+            if (args.stop_at_epoch is not None
+                    and epoch + 1 >= args.stop_at_epoch
+                    and epoch + 1 < args.epochs):
+                print("Stopping after epoch {} (--stop_at_epoch {}); rerun "
+                      "to resume.".format(epoch, args.stop_at_epoch),
+                      flush=True)
+                return
+
+    # the individual network at width 1.0
+    protocol.eval_widths([1.0], lambda w: model, recal_loader, test_loader,
+                         device, args.epochs, args.recal_batches,
+                         args.log_prefix)
+
+
+if __name__ == "__main__":
+    main()
