diff --git a/dyn_slim/models/dyn_slim_resnet.py b/dyn_slim/models/dyn_slim_resnet.py
new file mode 100644
index 0000000..c3fb7b7
--- /dev/null
+++ b/dyn_slim/models/dyn_slim_resnet.py
@@ -0,0 +1,254 @@
+"""DS-ResNets for the external protocol, built from DS-Net's slimmable ops.
+
+Addition for running DS-Net's supernet training (Stage I) under an external
+protocol; not part of the original release, which ships only DS-MBNet.
+
+- ds_resnet50_cifar: CIFAR ResNet-50 for 32x32 inputs. 3x3 stride-1 stem
+  conv, no max-pool, bottlenecks [3, 4, 6, 3] with the stride on the 3x3
+  conv, 1x1 conv + BN projection shortcuts, global average pool, linear
+  classifier.
+- ds_resnet18_tiny: ResNet-18 for 64x64 inputs (Tiny ImageNet). The same
+  stem at stride 2 (no max-pool), so the stages see 32, 16, 8 and 4 pixels
+  as on CIFAR; basic blocks [2, 2, 2, 2] (3x3 with the stride, 3x3), 1x1
+  conv + BN projection where the stride or the width changes.
+
+Every slimmable layer has one channel list with sixteen entries,
+make_divisible(C * w) for w = 0.25, 0.30, ..., 1.00 (DS-Net's own
+make_divisible, divisor 8), so channel choice i is width WIDTHS[i] in every
+layer at once: the stem, all convs and BNs, the shortcuts, the pooled feature
+and the classifier input. There is no routing gate (Stage II is not run).
+UniformChoiceMixin holds what every DS model here shares (mode/width
+selection, pooled feature, classifier, the optional H-IB predictor); the
+MobileNetV2 is in dyn_slim_mobilenetv2.py.
+"""
+import random
+
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+
+from dyn_slim.models.dyn_slim_blocks import set_exist_attr
+from dyn_slim.models.dyn_slim_ops import DSConv2d, DSpwConv2d, DSBatchNorm2d, DSLinear, \
+    DSAdaptiveAvgPool2d, make_divisible
+from dyn_slim.utils import efficientnet_init_weights
+
+try:
+    from timm.models import register_model
+except ImportError:
+    from timm.models.registry import register_model
+
+__all__ = ['DSResNet', 'UniformChoiceMixin', 'WIDTHS', 'channel_choices', 'clean_model_kwargs']
+
+WIDTHS = [round(0.25 + 0.05 * i, 2) for i in range(16)]
+
+
+def channel_choices(channels, widths=WIDTHS):
+    return [make_divisible(channels * w) for w in widths]
+
+
+def clean_model_kwargs(kwargs):
+    """drop what timm's create_model / upstream's train.py pass that these
+    models do not take"""
+    for key in ('pretrained_cfg', 'pretrained_cfg_overlay', 'global_pool', 'bn_tf',
+                'bn_momentum', 'bn_eps', 'drop_path_rate'):
+        kwargs.pop(key, None)
+    return kwargs
+
+
+class UniformChoiceMixin(object):
+    """One channel choice for all layers (the protocol's widths), the pooled
+    feature, the classifier and the H-IB predictor."""
+
+    def _init_head(self, num_features, hib, hib_hidden):
+        self.num_features = num_features
+        self.global_pool = DSAdaptiveAvgPool2d(1, channel_list=self.num_features)
+        self.classifier = DSLinear(self.num_features, self.num_classes)
+
+        # H-IB (DS-Net++, eq. 33, our addition): slimmable 2-layer MLP predictor
+        # phi = W2 relu(W1[:, :c] f), W1: hib_hidden x C, W2: C x hib_hidden, mapping
+        # the pooled feature of any width (c channels) to the widest one's C.
+        self.keep_pooled = hib
+        if hib:
+            self.hib_predictor = nn.Sequential(
+                DSLinear(self.num_features, hib_hidden),
+                nn.ReLU(inplace=True),
+                nn.Linear(hib_hidden, self.num_features[-1]))
+
+    def set_mode(self, mode, seed=None, choice=None):
+        """'largest', 'smallest', or 'uniform': one channel choice for every
+        layer, `choice` if given, else drawn as DSNet.set_mode draws it,
+        random.randint(1, num_choices - 1) (everything but the smallest)."""
+        if seed is not None:
+            random.seed(seed)
+        assert mode in ['largest', 'smallest', 'uniform'], \
+            'these DS models have no routing gate (dynamic mode is Stage II)'
+        self.mode = mode
+        for m in self.modules():
+            set_exist_attr(m, 'mode', mode)
+        if mode == 'largest':
+            self.channel_choice = -1
+        elif mode == 'smallest':
+            self.channel_choice = 0
+        else:
+            if choice is not None:
+                self.random_choice = choice
+            else:
+                self.random_choice = random.randint(1, len(self.widths) - 1)
+            self.channel_choice = self.random_choice
+
+    def set_width(self, width):
+        self.set_mode('uniform', choice=self.widths.index(round(width, 2)))
+
+    def _push_choice(self):
+        # DSConv2d resets its channel_choice after every forward, so the
+        # choice is handed to every layer at the start of each forward.
+        for m in self.modules():
+            if m is not self:
+                set_exist_attr(m, 'channel_choice', self.channel_choice)
+
+    def forward(self, x):
+        x = self.forward_features(x)
+        x = self.global_pool(x).flatten(1)
+        if self.keep_pooled:
+            self.pooled = x  # last layer's pooled feature, read by H-IB
+        if self.drop_rate > 0. and self.mode == 'largest':
+            x = F.dropout(x, p=self.drop_rate, training=self.training)
+        return self.classifier(x)
+
+
+class DSBasicBlock(nn.Module):
+    """3x3 (stride) -> 3x3, with DS-Net's slimmable convs and BN."""
+
+    def __init__(self, in_channels_list, out_channels_list, stride=1,
+                 norm_layer=DSBatchNorm2d):
+        super(DSBasicBlock, self).__init__()
+        self.conv1 = DSConv2d(in_channels_list, out_channels_list, kernel_size=3,
+                              stride=stride, bias=False)
+        self.bn1 = norm_layer(out_channels_list)
+        self.conv2 = DSConv2d(out_channels_list, out_channels_list, kernel_size=3,
+                              bias=False)
+        self.bn2 = norm_layer(out_channels_list)
+        self.relu = nn.ReLU(inplace=True)
+        self.has_residual = True
+        self.downsample = None
+        if stride != 1 or in_channels_list[-1] != out_channels_list[-1]:
+            self.downsample = nn.Sequential(
+                DSConv2d(in_channels_list, out_channels_list, kernel_size=1, stride=stride,
+                         bias=False),
+                norm_layer(out_channels_list))
+        self.channel_choice = -1
+        self.mode = 'largest'
+
+    def init_residual_norm(self, level='block'):
+        # as DSInvertedResidual / DSDepthwiseSeparable: zero gamma of the last BN
+        if level == 'block':
+            self.bn2.set_zero_weight()
+
+    def forward(self, x):
+        residual = x if self.downsample is None else self.downsample(x)
+        x = self.relu(self.bn1(self.conv1(x)))
+        x = self.bn2(self.conv2(x))
+        return self.relu(x + residual)
+
+
+class DSBottleneck(nn.Module):
+    """1x1 -> 3x3 (stride) -> 1x1 x4, with DS-Net's slimmable convs and BN."""
+
+    def __init__(self, in_channels_list, mid_channels_list, out_channels_list, stride=1,
+                 norm_layer=DSBatchNorm2d):
+        super(DSBottleneck, self).__init__()
+        self.conv1 = DSpwConv2d(in_channels_list, mid_channels_list, bias=False)
+        self.bn1 = norm_layer(mid_channels_list)
+        self.conv2 = DSConv2d(mid_channels_list, mid_channels_list, kernel_size=3,
+                              stride=stride, bias=False)
+        self.bn2 = norm_layer(mid_channels_list)
+        self.conv3 = DSpwConv2d(mid_channels_list, out_channels_list, bias=False)
+        self.bn3 = norm_layer(out_channels_list)
+        self.relu = nn.ReLU(inplace=True)
+        self.has_residual = True
+        self.downsample = None
+        if stride != 1 or in_channels_list[-1] != out_channels_list[-1]:
+            self.downsample = nn.Sequential(
+                DSConv2d(in_channels_list, out_channels_list, kernel_size=1, stride=stride,
+                         bias=False),
+                norm_layer(out_channels_list))
+        self.channel_choice = -1
+        self.mode = 'largest'
+
+    def init_residual_norm(self, level='block'):
+        # as DSInvertedResidual / DSDepthwiseSeparable: zero gamma of the last BN
+        if level == 'block':
+            self.bn3.set_zero_weight()
+
+    def forward(self, x):
+        residual = x if self.downsample is None else self.downsample(x)
+        x = self.relu(self.bn1(self.conv1(x)))
+        x = self.relu(self.bn2(self.conv2(x)))
+        x = self.bn3(self.conv3(x))
+        return self.relu(x + residual)
+
+
+class DSResNet(UniformChoiceMixin, nn.Module):
+    def __init__(self, num_classes=100, in_chans=3, layers=(3, 4, 6, 3), widths=WIDTHS,
+                 drop_rate=0., norm_layer=DSBatchNorm2d, hib=False, hib_hidden=2048,
+                 block='bottleneck', stem_stride=1, **kwargs):
+        super(DSResNet, self).__init__()
+        assert block in ('basic', 'bottleneck')
+        self.widths = list(widths)
+        self.num_classes = num_classes
+        self.drop_rate = drop_rate
+        expansion = 4 if block == 'bottleneck' else 1
+
+        stem = channel_choices(64, self.widths)
+        self.conv_stem = DSConv2d([in_chans], stem, kernel_size=3, stride=stem_stride,
+                                  bias=False)
+        self.bn1 = norm_layer(stem)
+        self.act1 = nn.ReLU(inplace=True)
+
+        blocks = []
+        in_list = stem
+        for c, n, s in zip([64, 128, 256, 512], layers, [1, 2, 2, 2]):
+            mid_list = channel_choices(c, self.widths)
+            out_list = channel_choices(expansion * c, self.widths)
+            for i in range(n):
+                stride = s if i == 0 else 1
+                if block == 'bottleneck':
+                    blocks.append(DSBottleneck(in_list, mid_list, out_list,
+                                               stride=stride, norm_layer=norm_layer))
+                else:
+                    blocks.append(DSBasicBlock(in_list, out_list,
+                                               stride=stride, norm_layer=norm_layer))
+                in_list = out_list
+        self.blocks = nn.Sequential(*blocks)
+
+        self._init_head(in_list, hib, hib_hidden)
+
+        with torch.no_grad():
+            efficientnet_init_weights(self)
+            self.init_residual_norm()
+        self.set_mode('largest')
+
+    def init_residual_norm(self):
+        for m in self.modules():
+            if isinstance(m, (DSBottleneck, DSBasicBlock)):
+                m.init_residual_norm(level='block')
+
+    def forward_features(self, x):
+        self._push_choice()
+        x = self.act1(self.bn1(self.conv_stem(x)))
+        return self.blocks(x)
+
+
+@register_model
+def ds_resnet50_cifar(pretrained=False, **kwargs):
+    assert not pretrained
+    return DSResNet(layers=(3, 4, 6, 3), block='bottleneck', stem_stride=1,
+                    **clean_model_kwargs(kwargs))
+
+
+@register_model
+def ds_resnet18_tiny(pretrained=False, **kwargs):
+    """ResNet-18 for 64x64 (Tiny ImageNet): stem 3x3 at stride 2, no max-pool."""
+    assert not pretrained
+    return DSResNet(layers=(2, 2, 2, 2), block='basic', stem_stride=2,
+                    **clean_model_kwargs(kwargs))
