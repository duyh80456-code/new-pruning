diff --git a/dyn_slim/models/dyn_slim_mobilenetv2.py b/dyn_slim/models/dyn_slim_mobilenetv2.py
new file mode 100644
index 0000000..2380eb8
--- /dev/null
+++ b/dyn_slim/models/dyn_slim_mobilenetv2.py
@@ -0,0 +1,146 @@
+"""DS-MobileNetV2 for 32x32 inputs (CIFAR-100), with the last 1x1 slimmed.
+
+Addition for running DS-Net's supernet training (Stage I) under an external
+protocol; not part of the original release. Built from DS-Net's slimmable
+ops (DSConv2d / DSpwConv2d / DSdwConv2d / DSBatchNorm2d / DSLinear /
+DSAdaptiveAvgPool2d). The layer sizes are those of a CIFAR MobileNetV2:
+3x3 stride-1 stem to 32, inverted residuals (t, c, n, s) = (1, 16, 1, 1),
+(6, 24, 2, 1), (6, 32, 3, 2), (6, 64, 4, 2), (6, 96, 3, 1), (6, 160, 3, 2),
+(6, 320, 1, 1) (ImageNet's second stride of 2 becomes 1), ReLU6, identity
+skip only where the stride is 1 and the widest input and output agree (no
+projection shortcut), then a 1x1 conv to 1280 + BN + ReLU6, global average
+pool, linear classifier. slim_last: that last 1x1 slims with the width as
+well (1280 x w channels, its BN and the classifier input with it).
+
+Channel choices (16, w = 0.25, 0.30, ..., 1.00, one choice for all layers):
+stem and block outputs make_divisible(C * w); the expansion layer and the
+depthwise conv make_divisible(C_in * t * w / t) * t, i.e. t times the
+block's input channels at that width (US-Net's ratio rounding); the last 1x1
+make_divisible(1280 * w). The depthwise conv is their DSdwConv2d (groups =
+the running channel count, as in their DS-MobileNetV1). No SE / gate.
+"""
+import torch
+import torch.nn as nn
+
+from dyn_slim.models.dyn_slim_ops import DSConv2d, DSpwConv2d, DSdwConv2d, DSBatchNorm2d, \
+    make_divisible
+from dyn_slim.models.dyn_slim_resnet import UniformChoiceMixin, WIDTHS, channel_choices, \
+    clean_model_kwargs
+from dyn_slim.utils import efficientnet_init_weights
+
+try:
+    from timm.models import register_model
+except ImportError:
+    from timm.models.registry import register_model
+
+__all__ = ['DSMobileNetV2Cifar']
+
+
+class DSInvertedResidualCifar(nn.Module):
+    """[1x1 expand + BN + ReLU6] -> 3x3 depthwise (stride) + BN + ReLU6 ->
+    1x1 project + BN; identity added when stride 1 and in == out."""
+
+    def __init__(self, in_channels_list, out_channels_list, mid_channels_list, stride,
+                 expand_ratio, norm_layer=DSBatchNorm2d):
+        super(DSInvertedResidualCifar, self).__init__()
+        self.has_residual = stride == 1 and in_channels_list[-1] == out_channels_list[-1]
+        if expand_ratio != 1:
+            self.conv_pw = DSpwConv2d(in_channels_list, mid_channels_list, bias=False)
+            self.bn1 = norm_layer(mid_channels_list)
+            self.act1 = nn.ReLU6(inplace=True)
+        else:
+            assert mid_channels_list == in_channels_list
+            self.conv_pw = None
+        self.conv_dw = DSdwConv2d(mid_channels_list, kernel_size=3, stride=stride, bias=False)
+        self.bn2 = norm_layer(mid_channels_list)
+        self.act2 = nn.ReLU6(inplace=True)
+        self.conv_pwl = DSpwConv2d(mid_channels_list, out_channels_list, bias=False)
+        self.bn3 = norm_layer(out_channels_list)
+        self.channel_choice = -1
+        self.mode = 'largest'
+
+    def init_residual_norm(self, level='block'):
+        # as DSInvertedResidual: zero gamma of the last BN, here only where
+        # there is a skip (a block without one would output zero)
+        if self.has_residual and level == 'block':
+            self.bn3.set_zero_weight()
+
+    def forward(self, x):
+        residual = x
+        if self.conv_pw is not None:
+            x = self.act1(self.bn1(self.conv_pw(x)))
+        x = self.act2(self.bn2(self.conv_dw(x)))
+        x = self.bn3(self.conv_pwl(x))
+        if self.has_residual:
+            x = x + residual
+        return x
+
+
+class DSMobileNetV2Cifar(UniformChoiceMixin, nn.Module):
+    # t, c, n, s; ImageNet's second stride of 2 becomes 1
+    block_setting = [
+        [1, 16, 1, 1],
+        [6, 24, 2, 1],
+        [6, 32, 3, 2],
+        [6, 64, 4, 2],
+        [6, 96, 3, 1],
+        [6, 160, 3, 2],
+        [6, 320, 1, 1],
+    ]
+
+    def __init__(self, num_classes=100, in_chans=3, widths=WIDTHS, drop_rate=0.,
+                 norm_layer=DSBatchNorm2d, hib=False, hib_hidden=2048, last_channels=1280,
+                 **kwargs):
+        super(DSMobileNetV2Cifar, self).__init__()
+        self.widths = list(widths)
+        self.num_classes = num_classes
+        self.drop_rate = drop_rate
+
+        stem = channel_choices(32, self.widths)
+        self.conv_stem = DSConv2d([in_chans], stem, kernel_size=3, stride=1, bias=False)
+        self.bn1 = norm_layer(stem)
+        self.act1 = nn.ReLU6(inplace=True)
+
+        blocks = []
+        in_list, in_max = stem, 32
+        for t, c, n, s in self.block_setting:
+            out_list = channel_choices(c, self.widths)
+            for i in range(n):
+                # US-Net's ratio rounding: make_divisible(C_exp * w / t) * t
+                mid_list = [make_divisible(in_max * t * w / t) * t for w in self.widths]
+                blocks.append(DSInvertedResidualCifar(in_list, out_list, mid_list,
+                                                      s if i == 0 else 1, t,
+                                                      norm_layer=norm_layer))
+                in_list, in_max = out_list, c
+        self.blocks = nn.Sequential(*blocks)
+
+        # slim_last: the last 1x1 to 1280 slims with the width
+        head = channel_choices(last_channels, self.widths)
+        self.conv_head = DSpwConv2d(in_list, head, bias=False)
+        self.bn2 = norm_layer(head)
+        self.act2 = nn.ReLU6(inplace=True)
+
+        self._init_head(head, hib, hib_hidden)
+
+        with torch.no_grad():
+            efficientnet_init_weights(self)
+            self.init_residual_norm()
+        self.set_mode('largest')
+
+    def init_residual_norm(self):
+        for m in self.modules():
+            if isinstance(m, DSInvertedResidualCifar):
+                m.init_residual_norm(level='block')
+
+    def forward_features(self, x):
+        self._push_choice()
+        x = self.act1(self.bn1(self.conv_stem(x)))
+        x = self.blocks(x)
+        return self.act2(self.bn2(self.conv_head(x)))
+
+
+@register_model
+def ds_mobilenetv2_cifar_slimlast(pretrained=False, **kwargs):
+    """CIFAR MobileNetV2 with the last 1x1 (to 1280) slimmed with the width."""
+    assert not pretrained
+    return DSMobileNetV2Cifar(**clean_model_kwargs(kwargs))
