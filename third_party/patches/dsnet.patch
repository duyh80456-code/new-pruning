@@ -0,0 +1,414 @@
+#
+# Additions for running DS-Net under an external protocol: the CIFAR-100 and
+# Tiny ImageNet loaders, a per-epoch resume checkpoint (model, EMA model,
+# optimizer, epoch, RNG states), BatchNorm recalibration per width, and a
+# fixed-format per-width evaluation line. Not part of the original release.
+#
+import hashlib
+import os
+import random
+import statistics
+import time
+import zipfile
+
+import numpy as np
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+
+CKPT_NAME = 'last.pt'
+_T0 = time.time()
+
+# the sixteen evaluated widths; also the channel choices of the DS models here
+# (ds_resnet50_cifar, ds_resnet18_tiny, ds_mobilenetv2_cifar_slimlast)
+WIDTHS = [round(0.25 + 0.05 * i, 2) for i in range(16)]
+
+CIFAR100_MEAN = (0.5071, 0.4865, 0.4409)
+CIFAR100_STD = (0.2673, 0.2564, 0.2762)
+
+
+def cifar100_loaders(data_dir, batch_size, workers):
+    """train (RandomCrop 32 pad 4 + HFlip, shuffled, drop_last like timm's
+    training loader), recalibration (same images and transform, its own
+    shuffle), test (10k, no augmentation)."""
+    import torchvision
+    import torchvision.transforms as transforms
+    train_tf = transforms.Compose([
+        transforms.RandomCrop(32, padding=4),
+        transforms.RandomHorizontalFlip(),
+        transforms.ToTensor(),
+        transforms.Normalize(CIFAR100_MEAN, CIFAR100_STD),
+    ])
+    test_tf = transforms.Compose([
+        transforms.ToTensor(),
+        transforms.Normalize(CIFAR100_MEAN, CIFAR100_STD),
+    ])
+    trainset = torchvision.datasets.CIFAR100(
+        root=data_dir, train=True, download=True, transform=train_tf)
+    testset = torchvision.datasets.CIFAR100(
+        root=data_dir, train=False, download=True, transform=test_tf)
+    common = dict(num_workers=workers, pin_memory=True,
+                  persistent_workers=workers > 0)
+    loader_train = torch.utils.data.DataLoader(
+        trainset, batch_size=batch_size, shuffle=True, drop_last=True, **common)
+    loader_recal = torch.utils.data.DataLoader(
+        trainset, batch_size=batch_size, shuffle=True, drop_last=True, **common)
+    loader_eval = torch.utils.data.DataLoader(
+        testset, batch_size=batch_size, shuffle=False, **common)
+    return loader_train, loader_recal, loader_eval
+
+
+# ---- Tiny ImageNet (200 classes, 100,000 train / 10,000 val images, 64x64) ----
+# As the protocol's own pipeline: the official val split, labelled by
+# val_annotations.txt, is the test set; the JPEGs are decoded once into uint8
+# arrays cached under data_dir/tinyimagenet_cache (same files, so a cache
+# written by the protocol's code is read as is). The data is found at
+# data_dir/tiny-imagenet-200, else any copy with the official layout under
+# /kaggle/input (also a zip of it), else the Stanford zip is downloaded into
+# data_dir.
+TINY_URL = 'http://cs231n.stanford.edu/tiny-imagenet-200.zip'
+TINY_FOLDER = 'tiny-imagenet-200'
+KAGGLE_INPUTS = '/kaggle/input'
+TINY_MEAN = (0.4802, 0.4481, 0.3975)  # per channel over the 100,000 train images
+TINY_STD = (0.2770, 0.2691, 0.2821)
+# md5 of the official 200 class ids, sorted, and of the 10,000 val labels as
+# sorted "file<TAB>class" lines (order and line endings do not enter)
+TINY_WNIDS_MD5 = '62ec2c49c5abdc833b8ea5082c79667d'
+TINY_VAL_MD5 = '10ec1929ae7b5715fce6b8e1d04e1b39'
+
+
+def _is_tiny(folder):
+    """the official layout, whatever the folder is called"""
+    return (os.path.isfile(os.path.join(folder, 'wnids.txt')) and
+            os.path.isfile(os.path.join(folder, 'val', 'val_annotations.txt'))
+            and os.path.isdir(os.path.join(folder, 'train')))
+
+
+def _check_official_tiny(folder):
+    """raise unless folder holds the official classes and val labels"""
+    with open(os.path.join(folder, 'wnids.txt')) as handle:
+        wnids = sorted(line.strip() for line in handle if line.strip())
+    with open(os.path.join(folder, 'val', 'val_annotations.txt')) as handle:
+        val = sorted('\t'.join(line.split('\t')[:2])
+                     for line in handle if line.strip())
+    found = (hashlib.md5('\n'.join(wnids).encode()).hexdigest(),
+             hashlib.md5('\n'.join(val).encode()).hexdigest())
+    if found != (TINY_WNIDS_MD5, TINY_VAL_MD5):
+        raise ValueError(
+            '{} is not the official Tiny ImageNet: class ids {}, val labels '
+            '{} (expected {}, {})'.format(
+                folder, found[0], found[1], TINY_WNIDS_MD5, TINY_VAL_MD5))
+    print('Tiny ImageNet at {}: official classes and val labels'.format(folder),
+          flush=True)
+
+
+def _locate_tiny(root):
+    """the tiny-imagenet-200 folder, downloading it if nothing has it"""
+    here = os.path.join(root, TINY_FOLDER)
+    if _is_tiny(here):
+        return here
+    archives = []
+    for top, dirs, files in os.walk(KAGGLE_INPUTS):
+        if 'wnids.txt' in files and _is_tiny(top):
+            return top
+        archives += [os.path.join(top, f) for f in files
+                     if f.lower().endswith('.zip')]
+        # do not descend into the 200 class folders of a train split
+        dirs[:] = [d for d in dirs if not d.startswith('n0')
+                   and not d.startswith('n1') and d != 'images']
+    os.makedirs(root, exist_ok=True)
+    archive = os.path.join(root, TINY_FOLDER + '.zip')
+    for candidate in archives:
+        with zipfile.ZipFile(candidate) as handle:
+            if TINY_FOLDER + '/wnids.txt' in handle.namelist():
+                print('unpacking Tiny ImageNet from', candidate, flush=True)
+                handle.extractall(root)
+                return here
+    if not os.path.isfile(archive):
+        print('no Tiny ImageNet with the official layout under {}; '
+              'downloading {}'.format(KAGGLE_INPUTS, TINY_URL), flush=True)
+        torch.hub.download_url_to_file(TINY_URL, archive)
+    with zipfile.ZipFile(archive) as handle:
+        handle.extractall(root)
+    return here
+
+
+def _decode_tiny(paths):
+    from PIL import Image
+    images = np.empty((len(paths), 64, 64, 3), dtype=np.uint8)
+    for i, path in enumerate(paths):
+        images[i] = np.asarray(Image.open(path).convert('RGB'))  # a few are greyscale
+    return images
+
+
+def _save_atomic(f, a):
+    """write then rename (per-pid part file), so a reader never sees half a file"""
+    part = '{}.{}.part.npy'.format(f, os.getpid())
+    np.save(part, a)
+    try:
+        os.replace(part, f)
+    except OSError:
+        if not os.path.isfile(f):
+            raise
+        os.remove(part)
+
+
+def _tiny_cache(folder, cache):
+    """paths of the cached (train_x, train_y, val_x, val_y) .npy files,
+    decoding the JPEGs once if they are not there. Labels: index of the
+    class id in the sorted wnids.txt; train images in sorted file order per
+    class, val images in val_annotations.txt order."""
+    names = ['train_x', 'train_y', 'val_x', 'val_y']
+    files = [os.path.join(cache, name + '.npy') for name in names]
+    if all(os.path.isfile(f) for f in files):
+        return files
+    with open(os.path.join(folder, 'wnids.txt')) as handle:
+        wnids = sorted(line.strip() for line in handle if line.strip())
+    label = {wnid: i for i, wnid in enumerate(wnids)}
+    train_paths, train_y = [], []
+    for wnid in wnids:
+        images = os.path.join(folder, 'train', wnid, 'images')
+        for name in sorted(os.listdir(images)):
+            train_paths.append(os.path.join(images, name))
+            train_y.append(label[wnid])
+    val_paths, val_y = [], []
+    with open(os.path.join(folder, 'val', 'val_annotations.txt')) as handle:
+        for line in handle:
+            parts = line.split('\t')
+            if len(parts) < 2:
+                continue
+            val_paths.append(os.path.join(folder, 'val', 'images', parts[0]))
+            val_y.append(label[parts[1]])
+    assert len(train_paths) == 100000 and len(val_paths) == 10000, (
+        len(train_paths), len(val_paths))
+    out = [_decode_tiny(train_paths), np.asarray(train_y, dtype=np.int64),
+           _decode_tiny(val_paths), np.asarray(val_y, dtype=np.int64)]
+    os.makedirs(cache, exist_ok=True)
+    for f, a in zip(files, out):
+        _save_atomic(f, a)
+    return files
+
+
+class TinyImageNet(torch.utils.data.Dataset):
+    """The cached uint8 images, opened as a read-only memory map in each
+    process: a spawned loader worker (Windows) receives the file path, not a
+    1.2 GB copy. Same images, labels and order as the in-memory arrays."""
+
+    def __init__(self, images_file, labels, transform):
+        self.images_file = images_file
+        self.labels = labels
+        self.transform = transform
+        self._images = None
+
+    def __getstate__(self):
+        state = self.__dict__.copy()
+        state['_images'] = None
+        return state
+
+    def __len__(self):
+        return len(self.labels)
+
+    def __getitem__(self, index):
+        from PIL import Image
+        if self._images is None:
+            self._images = np.load(self.images_file, mmap_mode='r')
+        image = Image.fromarray(np.array(self._images[index]))
+        return self.transform(image), int(self.labels[index])
+
+
+def tinyimagenet_loaders(data_dir, batch_size, workers):
+    """train (RandomCrop 64 pad 8 + HFlip, the CIFAR recipe at twice the
+    size; shuffled, drop_last like timm's training loader), recalibration
+    (same images and transform, its own shuffle), test (the 10k official
+    val split, no augmentation)."""
+    import torchvision.transforms as transforms
+    train_tf = transforms.Compose([
+        transforms.RandomCrop(64, padding=8),
+        transforms.RandomHorizontalFlip(),
+        transforms.ToTensor(),
+        transforms.Normalize(TINY_MEAN, TINY_STD),
+    ])
+    test_tf = transforms.Compose([
+        transforms.ToTensor(),
+        transforms.Normalize(TINY_MEAN, TINY_STD),
+    ])
+    folder = _locate_tiny(data_dir)
+    _check_official_tiny(folder)
+    # written where it can be: an attached Kaggle input is read-only
+    train_x, train_y, val_x, val_y = _tiny_cache(
+        folder, os.path.join(data_dir, 'tinyimagenet_cache'))
+    trainset = TinyImageNet(train_x, np.load(train_y), train_tf)
+    testset = TinyImageNet(val_x, np.load(val_y), test_tf)
+    assert len(trainset) == 100000 and len(testset) == 10000
+    common = dict(num_workers=workers, pin_memory=True,
+                  persistent_workers=workers > 0)
+    loader_train = torch.utils.data.DataLoader(
+        trainset, batch_size=batch_size, shuffle=True, drop_last=True, **common)
+    loader_recal = torch.utils.data.DataLoader(
+        trainset, batch_size=batch_size, shuffle=True, drop_last=True, **common)
+    loader_eval = torch.utils.data.DataLoader(
+        testset, batch_size=batch_size, shuffle=False, **common)
+    return loader_train, loader_recal, loader_eval
+
+
+# --dataset choices of train.py beyond upstream's ImageNet path
+DATASETS = {
+    'cifar100': dict(loaders=cifar100_loaders, image_size=32, num_classes=100),
+    'tinyimagenet': dict(loaders=tinyimagenet_loaders, image_size=64, num_classes=200),
+}
+
+
+def loaders(dataset, data_dir, batch_size, workers):
+    return DATASETS[dataset]['loaders'](data_dir, batch_size, workers)
+
+
+def _unwrap(net):
+    return net.module if hasattr(net, 'module') else net
+
+
+def save_checkpoint(ckpt_dir, model, model_ema, optimizer, next_epoch):
+    """Written atomically (.tmp + os.replace). The LR is a pure function of
+    the update count (timm scheduler), so the epoch is its whole state."""
+    path = os.path.join(ckpt_dir, CKPT_NAME)
+    os.makedirs(ckpt_dir, exist_ok=True)
+    state = {
+        'model': _unwrap(model).state_dict(),
+        'model_ema': _unwrap(model_ema.ema).state_dict()
+        if model_ema is not None else None,
+        'optimizer': optimizer.state_dict(),
+        'epoch': next_epoch,
+        'rng': {
+            'python': random.getstate(),
+            'numpy': np.random.get_state(),
+            'torch': torch.get_rng_state(),
+            'cuda': torch.cuda.get_rng_state_all()
+            if torch.cuda.is_available() else None,
+        },
+    }
+    tmp = path + '.tmp'
+    torch.save(state, tmp)
+    os.replace(tmp, path)
+    print('Saved checkpoint {} (next epoch {})'.format(path, next_epoch),
+          flush=True)
+
+
+def load_checkpoint(ckpt_dir, model, model_ema, optimizer, eval_only=False):
+    """Returns the epoch to start from (0 if there is no checkpoint)."""
+    path = os.path.join(ckpt_dir, CKPT_NAME)
+    if not os.path.isfile(path):
+        if eval_only:
+            raise FileNotFoundError(
+                '--eval_only but no checkpoint at {}'.format(path))
+        print('No checkpoint at {}; starting from epoch 0'.format(path),
+              flush=True)
+        return 0
+    state = torch.load(path, map_location='cpu', weights_only=False)
+    _unwrap(model).load_state_dict(state['model'])
+    if model_ema is not None:
+        if state.get('model_ema') is None:
+            raise RuntimeError('checkpoint has no EMA model')
+        _unwrap(model_ema.ema).load_state_dict(state['model_ema'])
+    optimizer.load_state_dict(state['optimizer'])
+    rng = state['rng']
+    random.setstate(rng['python'])
+    np.random.set_state(rng['numpy'])
+    torch.set_rng_state(rng['torch'])
+    if rng['cuda'] is not None and torch.cuda.is_available():
+        torch.cuda.set_rng_state_all(rng['cuda'])
+    print('Resumed from {} at epoch {}'.format(path, state['epoch']),
+          flush=True)
+    return state['epoch']
+
+
+_STEP = {'t': None, 'dts': []}
+
+
+def step_tick(batch_idx, skip=3):
+    """Steady-state step timer: starts after the first @skip steps of an
+    epoch (loader start-up), synchronising CUDA at each mark."""
+    if torch.cuda.is_available():
+        torch.cuda.synchronize()
+    now = time.time()
+    if batch_idx == skip - 1:
+        _STEP['dts'] = []
+    elif batch_idx >= skip and _STEP['t'] is not None:
+        _STEP['dts'].append(now - _STEP['t'])
+    _STEP['t'] = now
+
+
+def steady_rate():
+    dts = _STEP['dts']
+    if not dts:
+        return 'steady n/a'
+    return 'steady {:.3f} s/step mean, {:.3f} median over {} steps'.format(
+        sum(dts) / len(dts), statistics.median(dts), len(dts))
+
+
+def _tracked_bns(net):
+    return [m for m in net.modules()
+            if isinstance(m, nn.modules.batchnorm._NormBase)
+            and m.track_running_stats and m.running_mean is not None]
+
+
+@torch.no_grad()
+def recalibrate_bn(net, loader, n_batches, device):
+    """Reset running stats, then forward n_batches training batches in train
+    mode with a cumulative average (what momentum=None does in
+    nn.BatchNorm2d). DSBatchNorm2d hands aux_bn[-1].momentum straight to
+    F.batch_norm, which rejects None, so the factor 1/(i+1) is set
+    explicitly on every BatchNorm2d. Only the aux_bn of the width being
+    evaluated receives statistics; the others stay reset."""
+    bns = _tracked_bns(net)
+    if not bns or not n_batches:
+        return 0
+    saved = [m.momentum for m in bns]
+    for m in bns:
+        m.reset_running_stats()
+    net.train()
+    it = iter(loader)
+    for i in range(n_batches):
+        try:
+            data, _ = next(it)
+        except StopIteration:
+            it = iter(loader)
+            data, _ = next(it)
+        for m in bns:
+            m.momentum = 1.0 / (i + 1)
+        net(data.to(device, non_blocking=True))
+    for m, mom in zip(bns, saved):
+        m.momentum = mom
+    net.eval()
+    return len(bns)
+
+
+@torch.no_grad()
+def evaluate(net, loader, device):
+    net.eval()
+    loss_sum, c1, c5, n = 0.0, 0, 0, 0
+    for data, target in loader:
+        data = data.to(device, non_blocking=True)
+        target = target.to(device, non_blocking=True)
+        out = net(data)
+        loss_sum += F.cross_entropy(out, target, reduction='sum').item()
+        hit = out.topk(5, dim=1).indices.eq(target[:, None])
+        c1 += hit[:, 0].sum().item()
+        c5 += hit.any(dim=1).sum().item()
+        n += target.numel()
+    return loss_sum / n, 1.0 - c1 / n, 1.0 - c5 / n
+
+
+def eval_widths(net, widths, set_width, recal_loader, test_loader, device,
+                epochs, n_recal, log_prefix=''):
+    """One tab-separated line per width:
+    <elapsed>s  val  <width>  -1/<epochs>: loss: .., top1_error: .., top5_error: ..
+    """
+    prefix = '[{}] '.format(log_prefix) if log_prefix else ''
+    for w in widths:
+        set_width(w)
+        n_bn = recalibrate_bn(net, recal_loader, n_recal, device)
+        loss, e1, e5 = evaluate(net, test_loader, device)
+        if n_bn == 0 and w == widths[0]:
+            print('(no recalibration: evaluated with the trained running stats)')
+        print('{}{:.1f}s\tval\t{:.2f}\t-1/{}: loss: {:.4f}, top1_error: {:.4f}, '
+              'top5_error: {:.4f}'.format(prefix, time.time() - _T0, w, epochs,
+                                          loss, e1, e5), flush=True)
